# Required. Never commit your real .env.
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# Optional technical fallback; no fallback after safety refusals.
OPENROUTER_API_KEY=
FALLBACK_MODEL=openrouter/free
# Strongly recommended: numeric Telegram ID of @SoyLe0.
# If empty, first private /listaaggiorna by @SoyLe0 pins the ID in PostgreSQL.
ADMIN_USER_ID=
PORT=10000
AI_TIMEOUT_SECONDS=25
AI_MAX_TOKENS=1200
HISTORY_LIMIT=16
CONTEXT_CHARS=12000
PROFILE_BATCH_SIZE=8
USER_COOLDOWN_SECONDS=8
CHAT_COOLDOWN_SECONDS=3
GLOBAL_AI_RPM=20
MEDIA_PROBABILITY=0.08
MEDIA_COOLDOWN_SECONDS=180
# false: reuse observed group media only in the group where observed.
SHARE_GROUP_MEDIA=true
LOG_LEVEL=INFO
